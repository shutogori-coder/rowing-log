# Claude API キー（https://console.anthropic.com で発行）
# このファイルを .env という名前でコピーして値を入れてください。
# .env は Git に含まれません（フロントエンドにも送られません）。
ANTHROPIC_API_KEY=

# 使用するモデル（省略時: claude-opus-5-5）
# 費用を抑えたい場合は claude-haiku-5-5 や claude-sonnet-5-5 に変更できます。
CLAUDE_MODEL=claude-opus-5-5

# 考える深さ low / medium / high（省略時: medium）。low ほど安く速い。
CLAUDE_EFFORT=medium

# 1回に変換できる最大文字数（省略時: 20000）
MAX_INPUT_CHARS=20000

# サーバーのポート（省略時: 3000）
PORT=3000
